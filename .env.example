# Production auth/database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Email verification link (not OTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=VietVerse <onboarding@resend.dev>

# OAuth providers are configured inside Supabase Auth
# Google + Discord redirect URI in Google/Discord must point to:
# https://YOUR_DOMAIN/api/auth/oauth/google/callback
# https://YOUR_DOMAIN/api/auth/oauth/discord/callback

# AI (optional)
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Optional stable public URL (recommended on Netlify)
PUBLIC_SITE_URL=https://vietverse1.netlify.app
